[
 {
  "id": "g001",
  "form": "-고 싶다",
  "level": "初级",
  "cat": "意愿",
  "attach": "动词词干 + 고 싶다",
  "meaning": "想要做某事",
  "desc": "表达说话人自己的愿望，是最基础的意愿表达。主语一般是「我」；问句里用来问对方的想法。",
  "ex": [
   {
    "kr": "저는 한국에 가고 싶어요.",
    "zh": "我想去韩国。"
   },
   {
    "kr": "무슨 책을 읽고 싶어요?",
    "zh": "你想读什么书？"
   },
   {
    "kr": "물을 마시고 싶어요.",
    "zh": "我想喝水。"
   }
  ],
  "note": "主语是第三人称时不能直接用 -고 싶다，要把愿望说成对方的心理状态 -고 싶어하다：민수 씨는 가고 싶어해요（民秀想去）。说 민수 씨는 가고 싶어요 会被理解成「（我猜）民秀想去」。",
  "cmp": "-고 싶다 偏中性、书面；-(으)ㄹ래요 更口语，带「要不要」的商量口气。"
 },
 {
  "id": "g002",
  "form": "-아/어요",
  "level": "初级",
  "cat": "语体",
  "attach": "词干 + 아요 / 어요",
  "meaning": "非格式体尊敬（해요体）",
  "desc": "日常会话最常用的语体，礼貌但不过分正式。词干最后一个元音是 ㅏ/ㅗ 接 -아요，其余接 -어요，하다 变 해요。",
  "ex": [
   {
    "kr": "저는 매일 한국어를 공부해요.",
    "zh": "我每天学韩语。"
   },
   {
    "kr": "오늘 날씨가 좋아요.",
    "zh": "今天天气好。"
   },
   {
    "kr": "내일 친구를 만나요.",
    "zh": "明天见朋友。"
   }
  ],
  "note": "名词谓语的礼貌形是 -이에요/예요，不是 -아/어요：저는 학생이에요。",
  "cmp": "对长辈或正式场合用 -ㅂ니다/습니다，해요体更适合朋友、同事、店员这类关系。"
 },
 {
  "id": "g003",
  "form": "-았/었어요",
  "level": "初级",
  "cat": "时态",
  "attach": "词干 + 았어요 / 었어요",
  "meaning": "过去时（非格式体尊敬）",
  "desc": "表示动作已经完成或状态已经形成。元音 ㅏ/ㅗ 接 -았어요，其余接 -었어요，하다 变 했어요。",
  "ex": [
   {
    "kr": "어제 영화를 봤어요.",
    "zh": "昨天看了电影。"
   },
   {
    "kr": "아침에 빵을 먹었어요.",
    "zh": "早上吃了面包。"
   },
   {
    "kr": "주말에 집에서 쉬었어요.",
    "zh": "周末在家休息了。"
   }
  ],
  "note": "形容词用过去时表示「状态变成那样/当时是那样」：어제는 추웠어요（昨天很冷）。",
  "cmp": "单纯叙述事实用 -았/었어요；强调「曾经做过」用 -아/어 본 적이 있다。"
 },
 {
  "id": "g004",
  "form": "-(으)ㄹ 거예요",
  "level": "初级",
  "cat": "时态",
  "attach": "词干 + ㄹ 거예요 / 을 거예요",
  "meaning": "将来时 / 推测",
  "desc": "主语是第一人称时多表意志（打算做）；第三人称时多表推测（大概会）。",
  "ex": [
   {
    "kr": "내일 비가 올 거예요.",
    "zh": "明天大概会下雨。"
   },
   {
    "kr": "저녁에 친구를 만날 거예요.",
    "zh": "晚上打算见朋友。"
   },
   {
    "kr": "그 영화는 재미있을 거예요.",
    "zh": "那部电影应该挺好看的。"
   }
  ],
  "note": "有收音接 -을 거예요，无收音或 ㄹ 收音接 -ㄹ 거예요（살다 → 살 거예요）。",
  "cmp": "-(으)ㄹ게요 只用于第一人称、且是对听话人的承诺或告知；-(으)ㄹ 거예요 没有这个限制。"
 },
 {
  "id": "g005",
  "form": "-(으)세요",
  "level": "初级",
  "cat": "敬语",
  "attach": "词干 + 세요 / 으세요",
  "meaning": "请……（尊敬的命令/请求）",
  "desc": "对长辈、客人、陌生人提出请求时用，也是日常最常见的「请」。",
  "ex": [
   {
    "kr": "앉으세요.",
    "zh": "请坐。"
   },
   {
    "kr": "천천히 드세요.",
    "zh": "请慢用。"
   },
   {
    "kr": "여기에서 기다리세요.",
    "zh": "请在这里等。"
   }
  ],
  "note": "먹다/마시다 的敬语是 드시다 → 드세요；있다 的敬语是 계시다 → 계세요。",
  "cmp": "对自己不能用 -으세요；「我来做」要说 -(으)ㄹ게요 或 제가 할게요。"
 },
 {
  "id": "g006",
  "form": "-지 않다",
  "level": "初级",
  "cat": "否定",
  "attach": "词干 + 지 않다",
  "meaning": "不……（长否定）",
  "desc": "把否定放在谓语里，语气比 안 稍正式，书面和口语都能用。",
  "ex": [
   {
    "kr": "오늘은 춥지 않아요.",
    "zh": "今天不冷。"
   },
   {
    "kr": "저는 고기를 먹지 않아요.",
    "zh": "我不吃肉。"
   },
   {
    "kr": "그 문제는 어렵지 않습니다.",
    "zh": "那个问题不难。"
   }
  ],
  "note": "名词谓语的否定是 이/가 아니다：학생이 아니에요，不能说 학생지 않아요。",
  "cmp": "长否定 -지 않다 适合书面、说明性句子；短否定 안 更口语、更直接。"
 },
 {
  "id": "g007",
  "form": "안 + 动词/形容词",
  "level": "初级",
  "cat": "否定",
  "attach": "안 + 谓语",
  "meaning": "不……（短否定）",
  "desc": "最口语的否定，直接把 안 放在谓语前面。",
  "ex": [
   {
    "kr": "저는 커피를 안 마셔요.",
    "zh": "我不喝咖啡。"
   },
   {
    "kr": "오늘은 안 추워요.",
    "zh": "今天不冷。"
   },
   {
    "kr": "내일은 안 바빠요.",
    "zh": "明天不忙。"
   }
  ],
  "note": "「有对应汉字词名词」的动词更常说 안 하다：공부를 안 해요 / 공부하지 않아요。",
  "cmp": "못 表示「不能（做不到）」，안 表示「不做（不愿意/没做）」，别混。"
 },
 {
  "id": "g008",
  "form": "못 + 动词",
  "level": "初级",
  "cat": "否定",
  "attach": "못 + 动词",
  "meaning": "不能……（能力或外部原因不允许）",
  "desc": "表示客观上做不到，不是因为不想。",
  "ex": [
   {
    "kr": "저는 매운 음식을 못 먹어요.",
    "zh": "我不能吃辣的。"
   },
   {
    "kr": "어제 잠을 못 잤어요.",
    "zh": "昨天没睡成觉。"
   },
   {
    "kr": "저는 수영을 못 해요.",
    "zh": "我不会游泳。"
   }
  ],
  "note": "名词 + 하다 的动词要把 못 放中间：수영을 못 해요，不能说 못 수영해요。",
  "cmp": "안 是「不做」，못 是「做不到」。저는 안 먹어요 = 我不吃（不想）；못 먹어요 = 我吃不了。"
 },
 {
  "id": "g009",
  "form": "-지 못하다",
  "level": "初级",
  "cat": "否定",
  "attach": "词干 + 지 못하다",
  "meaning": "不能……（长否定）",
  "desc": "못 的书面/长否定形式，语气比 못 稍正式。",
  "ex": [
   {
    "kr": "오늘은 학교에 가지 못했어요.",
    "zh": "今天没能去学校。"
   },
   {
    "kr": "그 책을 아직 읽지 못했어요.",
    "zh": "那本书还没能读完。"
   },
   {
    "kr": "시험이 어려워서 다 풀지 못했어요.",
    "zh": "考试太难，没能全做完。"
   }
  ],
  "note": "别和 -지 않다 混淆：-지 않다 是「不做」，-지 못하다 是「做不到」。",
  "cmp": ""
 },
 {
  "id": "g010",
  "form": "-고",
  "level": "初级",
  "cat": "连接",
  "attach": "词干 + 고",
  "meaning": "……并且 / ……然后",
  "desc": "既可以并列两个事实，也可以表示动作的先后。前后主语可以不同。",
  "ex": [
   {
    "kr": "밥을 먹고 영화를 봤어요.",
    "zh": "吃了饭然后看了电影。"
   },
   {
    "kr": "한국어는 재미있고 어려워요.",
    "zh": "韩语有趣而且难。"
   },
   {
    "kr": "제 방은 작고 조용해요.",
    "zh": "我的房间小且安静。"
   }
  ],
  "note": "表先后时前后主语要一致；主语不同时 -고 只表并列。",
  "cmp": "先后的强调说法是 -고 나서 / -고서，普通叙述用 -고 就够。"
 },
 {
  "id": "g011",
  "form": "-지만",
  "level": "初级",
  "cat": "连接",
  "attach": "词干 + 지만",
  "meaning": "虽然……但是……",
  "desc": "连接两个相反的事实，是最基础的转折。",
  "ex": [
   {
    "kr": "이 옷은 예쁘지만 비싸요.",
    "zh": "这件衣服好看但贵。"
   },
   {
    "kr": "한국어는 어렵지만 재미있어요.",
    "zh": "韩语难但有趣。"
   },
   {
    "kr": "어제는 피곤했지만 일했어요.",
    "zh": "昨天很累但还是工作了。"
   }
  ],
  "note": "前后主语可以不同，比 -는데 的转折更明确。",
  "cmp": "更口语的转折是 -기는 하지만（让步后再转），-지만 更中性。"
 },
 {
  "id": "g012",
  "form": "-아서/어서",
  "level": "初级",
  "cat": "原因",
  "attach": "词干 + 아서 / 어서",
  "meaning": "因为……所以…… / ……然后……",
  "desc": "既能表原因，也能表动作的顺承（前一动作结束后自然地做后一动作）。",
  "ex": [
   {
    "kr": "비가 와서 집에 있었어요.",
    "zh": "因为下雨就待在家里了。"
   },
   {
    "kr": "배가 아파서 약을 먹었어요.",
    "zh": "因为肚子疼吃了药。"
   },
   {
    "kr": "친구를 만나서 같이 밥을 먹었어요.",
    "zh": "见了朋友一起吃了饭。"
   }
  ],
  "note": "表原因时，后面不能接命令句或劝诱句。「因为下雨，请待在家」要用 -(으)니까。",
  "cmp": "-아서 偏客观原因；-(으)니까 带说话人的判断，后面能接命令和建议。"
 },
 {
  "id": "g013",
  "form": "-(으)니까",
  "level": "初级",
  "cat": "原因",
  "attach": "词干 + 니까 / 으니까",
  "meaning": "因为……（所以）",
  "desc": "表原因时带说话人的判断或主张，所以后面可以接命令句、劝诱句 —— 这是它和 -아서 最大的区别。",
  "ex": [
   {
    "kr": "비가 오니까 우산을 가져가세요.",
    "zh": "因为下雨，带上伞吧。"
   },
   {
    "kr": "시간이 없으니까 빨리 갑시다.",
    "zh": "没时间了，快点走吧。"
   },
   {
    "kr": "피곤하니까 일찍 자세요.",
    "zh": "累了就早点睡吧。"
   }
  ],
  "note": "前面不能用过去时 -았/었-：비가 왔으니까 ✗，要说 비가 오니까。",
  "cmp": "回答别人的问题时用 -아서/어서 更自然；提出主张、命令时用 -(으)니까。"
 },
 {
  "id": "g014",
  "form": "-(으)면",
  "level": "初级",
  "cat": "条件",
  "attach": "词干 + 면 / 으면",
  "meaning": "如果……就……",
  "desc": "最基础的条件句。ㄹ 收音不脱落：힘들면（不是 힘드면）。",
  "ex": [
   {
    "kr": "비가 오면 집에 있을 거예요.",
    "zh": "下雨的话就待在家。"
   },
   {
    "kr": "시간이 있으면 같이 가요.",
    "zh": "有时间的话一起去吧。"
   },
   {
    "kr": "돈이 많으면 여행을 하고 싶어요.",
    "zh": "钱多的话我想去旅行。"
   }
  ],
  "note": "ㄹ 收音的特殊处理：살다 → 살면、힘들다 → 힘들면，不加 으。",
  "cmp": "-(으)ㄴ다면 是虚拟假设（与事实相反），-(으)면 是一般条件。"
 },
 {
  "id": "g015",
  "form": "-는데",
  "level": "初级",
  "cat": "连接",
  "attach": "词干 + 는데 / 은데",
  "meaning": "……（背景铺垫）/ 可是……",
  "desc": "先给出背景，再说后面的情况；也可以用来委婉地转折。口语里使用频率极高。",
  "ex": [
   {
    "kr": "지금 비가 오는데 우산이 없어요.",
    "zh": "现在在下雨，可我没伞。"
   },
   {
    "kr": "저는 학생인데 아르바이트를 해요.",
    "zh": "我是学生，同时在打工。"
   },
   {
    "kr": "이 식당은 유명한데 사람이 별로 없어요.",
    "zh": "这家店很有名，可人不多。"
   }
  ],
  "note": "动词现在时接 -는데，形容词接 -(으)ㄴ데，名词接 -인데，过去时接 -았/었는데。",
  "cmp": "转折强度比 -지만 弱，更像「顺便说一句……」。"
 },
 {
  "id": "g016",
  "form": "-러/으러 가다",
  "level": "初级",
  "cat": "目的",
  "attach": "动词 + 러 / 으러 + 가다/오다",
  "meaning": "去做某事",
  "desc": "表示移动的目的，后面必须跟 가다/오다 这类移动动词。",
  "ex": [
   {
    "kr": "밥을 먹으러 갈까요?",
    "zh": "去吃饭好吗？"
   },
   {
    "kr": "책을 사러 서점에 갔어요.",
    "zh": "去书店买书了。"
   },
   {
    "kr": "친구를 만나러 왔어요.",
    "zh": "我是来见朋友的。"
   }
  ],
  "note": "前面只能接动词，不能接名词。有收音用 -으러，无收音或 ㄹ 收音用 -러。",
  "cmp": "如果后面不是移动动词，要用 -(으)려고：책을 사려고 서점에 갔어요。"
 },
 {
  "id": "g017",
  "form": "-(으)려고 하다",
  "level": "初级",
  "cat": "意愿",
  "attach": "词干 + 려고 하다",
  "meaning": "打算…… / 正要……",
  "desc": "表示计划或意图，比 -(으)ㄹ 거예요 更强调「心里打算」。",
  "ex": [
   {
    "kr": "내일부터 운동을 하려고 해요.",
    "zh": "打算从明天开始运动。"
   },
   {
    "kr": "한국에 유학을 가려고 해요.",
    "zh": "打算去韩国留学。"
   },
   {
    "kr": "이번 주말에 뭐 하려고 해요?",
    "zh": "这周末打算做什么？"
   }
  ],
  "note": "主语只能是第一人称或可以推测意图的第三人称；不能直接对听话人下命令。",
  "cmp": "-(으)려고요 是口语缩略，意思相同。"
 },
 {
  "id": "g018",
  "form": "-(으)ㄹ 수 있다/없다",
  "level": "初级",
  "cat": "可能",
  "attach": "词干 + ㄹ 수 있다",
  "meaning": "能…… / 不能……",
  "desc": "表示能力或可能性。否定是 -(으)ㄹ 수 없다。",
  "ex": [
   {
    "kr": "저는 한국어를 조금 말할 수 있어요.",
    "zh": "我能说一点韩语。"
   },
   {
    "kr": "내일은 시간이 없어서 갈 수 없어요.",
    "zh": "明天没时间，去不了。"
   },
   {
    "kr": "여기에서 사진을 찍을 수 있어요?",
    "zh": "这里可以拍照吗？"
   }
  ],
  "note": "「会做某事（技能）」用 -(으)ㄹ 줄 알다，不能说 -(으)ㄹ 수 있다；수영할 줄 알아요（我会游泳）。",
  "cmp": "-(으)ㄹ 수 없다 是「不能」，안 하다 是「不做」，别混。"
 },
 {
  "id": "g019",
  "form": "-아/어야 하다",
  "level": "初级",
  "cat": "义务",
  "attach": "词干 + 아야/어야 하다",
  "meaning": "必须…… / 得……",
  "desc": "表示义务或必要性。更口语的说法是 -아/어야 되다。",
  "ex": [
   {
    "kr": "내일까지 숙제를 해야 해요.",
    "zh": "明天之前得把作业做完。"
   },
   {
    "kr": "약을 먹어야 해요.",
    "zh": "得吃药。"
   },
   {
    "kr": "지금 출발해야 해요.",
    "zh": "现在得出发了。"
   }
  ],
  "note": "否定「不必」是 -지 않아도 되다，不是 -아/어야 하지 않다。",
  "cmp": "-아/어야 하다 和 -아/어야 되다 意思基本一样，后者更口语。"
 },
 {
  "id": "g020",
  "form": "-아/어도 되다",
  "level": "初级",
  "cat": "许可",
  "attach": "词干 + 아도/어도 되다",
  "meaning": "可以……（被允许）",
  "desc": "征求许可或表示允许。问句里常用来问「我可以……吗」。",
  "ex": [
   {
    "kr": "여기 앉아도 돼요?",
    "zh": "我可以坐这儿吗？"
   },
   {
    "kr": "내일 와도 돼요.",
    "zh": "明天来也行。"
   },
   {
    "kr": "이거 써도 돼요?",
    "zh": "这个我可以用吗？"
   }
  ],
  "note": "否定「不可以」是 -(으)면 안 되다，不是 -아/어도 안 되다。",
  "cmp": "-(으)셔도 되다 是对长辈的说法：앉으셔도 돼요。"
 },
 {
  "id": "g021",
  "form": "-지 마세요",
  "level": "初级",
  "cat": "否定",
  "attach": "词干 + 지 마세요",
  "meaning": "请不要……",
  "desc": "禁止或劝阻对方做某事。对平辈口语是 -지 마。",
  "ex": [
   {
    "kr": "걱정하지 마세요.",
    "zh": "别担心。"
   },
   {
    "kr": "여기에서 사진을 찍지 마세요.",
    "zh": "请不要在这里拍照。"
   },
   {
    "kr": "너무 많이 먹지 마세요.",
    "zh": "别吃太多。"
   }
  ],
  "note": "只能用于对方，不能用于自己。「我不做」要说 안 할게요。",
  "cmp": "更礼貌的禁止是 -(으)시지 마세요；正式告示用 -지 마십시오。"
 },
 {
  "id": "g022",
  "form": "-(으)ㄹ까요?",
  "level": "初级",
  "cat": "提议",
  "attach": "词干 + ㄹ까요 / 을까요",
  "meaning": "要……吗？ / 要不要……？ / 会……吗？",
  "desc": "主语是「我们」时表提议，主语是第三人称时表推测疑问。",
  "ex": [
   {
    "kr": "같이 점심을 먹을까요?",
    "zh": "一起吃午饭好吗？"
   },
   {
    "kr": "내일 날씨가 좋을까요?",
    "zh": "明天天气会好吗？"
   },
   {
    "kr": "창문을 닫을까요?",
    "zh": "要关窗吗？"
   }
  ],
  "note": "对长辈提议要用 -(으)실까요 或 -(으)세요，不能直接用 -(으)ㅂ시다。",
  "cmp": "-(으)ㄹ래요? 更口语、更直接，带点「你想不想」的味道。"
 },
 {
  "id": "g023",
  "form": "-(으)ㅂ시다",
  "level": "初级",
  "cat": "提议",
  "attach": "词干 + ㅂ시다 / 읍시다",
  "meaning": "我们一起……吧",
  "desc": "对同辈或晚辈提议共同行动，语气比较干脆。",
  "ex": [
   {
    "kr": "같이 갑시다.",
    "zh": "一起去吧。"
   },
   {
    "kr": "점심을 먹읍시다.",
    "zh": "吃午饭吧。"
   },
   {
    "kr": "내일 다시 만납시다.",
    "zh": "明天再见吧。"
   }
  ],
  "note": "对长辈绝对不能用，要说 같이 가세요 或 같이 가실까요。",
  "cmp": "口语里 -아/어요 也能表提议：같이 가요，语气更柔和。"
 },
 {
  "id": "g024",
  "form": "-는 것",
  "level": "初级",
  "cat": "名词化",
  "attach": "动词词干 + 는 것",
  "meaning": "……这件事",
  "desc": "把动词短语变成名词，可以接助词、当主语或宾语。口语常缩成 -는 거。",
  "ex": [
   {
    "kr": "운동하는 것을 좋아해요.",
    "zh": "我喜欢运动。"
   },
   {
    "kr": "한국어를 배우는 것은 재미있어요.",
    "zh": "学韩语很有意思。"
   },
   {
    "kr": "제 취미는 영화를 보는 것이에요.",
    "zh": "我的爱好是看电影。"
   }
  ],
  "note": "形容词不能用 -는 것 名词化，要用 -(으)ㅁ 或其他方式。",
  "cmp": "-는 것 口语化，-기 更书面，且常跟 쉽다/어렵다/힘들다 搭配。"
 },
 {
  "id": "g025",
  "form": "-기",
  "level": "初级",
  "cat": "名词化",
  "attach": "词干 + 기",
  "meaning": "……（这件事）",
  "desc": "名词化后缀，常出现在「-기가 쉽다/어렵다/힘들다/좋다」这类评价句里。",
  "ex": [
   {
    "kr": "한국어를 배우기가 어려워요.",
    "zh": "学韩语很难。"
   },
   {
    "kr": "수영하기를 좋아해요.",
    "zh": "我喜欢游泳。"
   },
   {
    "kr": "아침에 일찍 일어나기가 힘들어요.",
    "zh": "早上早起很吃力。"
   }
  ],
  "note": "-기 后面接 가/를 都可以，但 -기가 更常见。",
  "cmp": "-는 것 更口语、能带时态（-는 것 / -은 것 / -을 것）；-기 时态中立。"
 },
 {
  "id": "g026",
  "form": "-(으)ㄴ/는/(으)ㄹ + 名词",
  "level": "初级",
  "cat": "定语",
  "attach": "动词/形容词 + 定语形 + 名词",
  "meaning": "……的（修饰名词）",
  "desc": "把谓语变成定语修饰名词。动词：过去 -(으)ㄴ、现在 -는、将来 -(으)ㄹ；形容词现在时用 -(으)ㄴ。",
  "ex": [
   {
    "kr": "어제 본 영화가 재미있었어요.",
    "zh": "昨天看的电影很好看。"
   },
   {
    "kr": "지금 읽는 책이 어려워요.",
    "zh": "现在读的书很难。"
   },
   {
    "kr": "내일 할 일이 많아요.",
    "zh": "明天要做的事很多。"
   }
  ],
  "note": "最容易错的是形容词：예쁜 옷（对）、예쁘는 옷（错）；있다/없다 现在定语用 -는：없는 사람。",
  "cmp": "动词 vs 形容词的定语形不同，这是韩语最容易混的一块，见「对比」栏。"
 },
 {
  "id": "g027",
  "form": "-보다",
  "level": "初级",
  "cat": "比较",
  "attach": "名词 + 보다（+ 더）",
  "meaning": "比……",
  "desc": "比较两个对象，通常配 더（更）或 덜（不那么）。",
  "ex": [
   {
    "kr": "오늘이 어제보다 더 추워요.",
    "zh": "今天比昨天更冷。"
   },
   {
    "kr": "비행기가 기차보다 빨라요.",
    "zh": "飞机比火车快。"
   },
   {
    "kr": "저는 동생보다 키가 커요.",
    "zh": "我比弟弟高。"
   }
  ],
  "note": "정보 后面可以加 -보다 더，但「더」不是必须的。",
  "cmp": "「一样」用 처럼/만큼；「不如」用 만 못하다。"
 },
 {
  "id": "g028",
  "form": "-에서 / -부터 ~ -까지",
  "level": "初级",
  "cat": "助词",
  "attach": "地点 + 에서 / 时间 + 부터 + 까지",
  "meaning": "从……到……",
  "desc": "空间起点用 -에서，时间起点用 -부터；终点都用 -까지。",
  "ex": [
   {
    "kr": "학교에서 집까지 걸어서 갔어요.",
    "zh": "从学校走到了家。"
   },
   {
    "kr": "서울에서 부산까지 기차로 가요.",
    "zh": "从首尔坐火车去釜山。"
   },
   {
    "kr": "아침부터 밤까지 일했어요.",
    "zh": "从早到晚工作了。"
   }
  ],
  "note": "时间起点不用 -에서：아침에서 ✗，要 아침부터。",
  "cmp": ""
 },
 {
  "id": "g029",
  "form": "-에게 / -한테",
  "level": "初级",
  "cat": "助词",
  "attach": "人 + 에게 / 한테",
  "meaning": "给…… / 对……",
  "desc": "表示动作的对象是人。-한테 更口语，-에게 稍正式。",
  "ex": [
   {
    "kr": "친구에게 편지를 썼어요.",
    "zh": "给朋友写了信。"
   },
   {
    "kr": "동생한테 선물을 줬어요.",
    "zh": "给了弟弟礼物。"
   },
   {
    "kr": "누구한테 물어봤어요?",
    "zh": "问谁了？"
   }
  ],
  "note": "长辈要用 께：선생님께 물어보세요，不能用 한테/에게。",
  "cmp": "非人类对象用 에：회사에 전화했어요。"
 },
 {
  "id": "g030",
  "form": "-(으)로",
  "level": "初级",
  "cat": "助词",
  "attach": "名词 + 로 / 으로",
  "meaning": "往…… / 用……（方向、手段、材料）",
  "desc": "可表示方向、交通工具、手段、材料、语言。",
  "ex": [
   {
    "kr": "지하철로 회사에 가요.",
    "zh": "坐地铁去公司。"
   },
   {
    "kr": "한국어로 말해 주세요.",
    "zh": "请用韩语说。"
   },
   {
    "kr": "나무로 만든 책상이에요.",
    "zh": "是木头做的桌子。"
   }
  ],
  "note": "有收音接 -으로，无收音或 ㄹ 收音接 -로：버스로、지하철로、나무로、연필로。",
  "cmp": ""
 },
 {
  "id": "g031",
  "form": "-에",
  "level": "初级",
  "cat": "助词",
  "attach": "时间/地点 + 에",
  "meaning": "在……（时间、存在场所、目的地）",
  "desc": "接时间名词表时间点，接场所表存在位置或移动终点。",
  "ex": [
   {
    "kr": "아홉 시에 만나요.",
    "zh": "九点见。"
   },
   {
    "kr": "책이 책상 위에 있어요.",
    "zh": "书在桌上。"
   },
   {
    "kr": "주말에 뭐 해요?",
    "zh": "周末做什么？"
   }
  ],
  "note": "有动作发生的场所要用 -에서：도서관에서 공부해요，不能说 도서관에 공부해요。",
  "cmp": "에 = 存在/方向，에서 = 动作发生地，这是初学者最常混的一对。"
 },
 {
  "id": "g032",
  "form": "-이/가 있다/없다",
  "level": "初级",
  "cat": "句型",
  "attach": "名词 + 이/가 있다 / 없다",
  "meaning": "有…… / 没有……",
  "desc": "表示存在或拥有。主题用 은/는，新信息用 이/가。",
  "ex": [
   {
    "kr": "책상 위에 책이 있어요.",
    "zh": "桌上有书。"
   },
   {
    "kr": "냉장고에 우유가 없어요.",
    "zh": "冰箱里没有牛奶。"
   },
   {
    "kr": "시간이 있어요?",
    "zh": "有时间吗？"
   }
  ],
  "note": "「人拥有某物」用 이/가 있다，但「人在某处」用 에 있다：저는 집에 있어요。",
  "cmp": ""
 },
 {
  "id": "g033",
  "form": "-도",
  "level": "初级",
  "cat": "助词",
  "attach": "名词 + 도",
  "meaning": "也 / 连……都",
  "desc": "表示添加或强调。和 은/는、이/가、을/를 叠加时要替换掉它们。",
  "ex": [
   {
    "kr": "저도 학생이에요.",
    "zh": "我也是学生。"
   },
   {
    "kr": "오늘도 비가 와요.",
    "zh": "今天也下雨。"
   },
   {
    "kr": "커피도 마시고 차도 마셨어요.",
    "zh": "咖啡也喝了，茶也喝了。"
   }
  ],
  "note": "도 替换主格/宾格助词：저도（不是 저가도）、밥도（不是 밥을도）。",
  "cmp": ""
 },
 {
  "id": "g034",
  "form": "-만",
  "level": "初级",
  "cat": "助词",
  "attach": "名词 + 만",
  "meaning": "只 / 仅",
  "desc": "限定范围，语气中性。",
  "ex": [
   {
    "kr": "물만 마셔요.",
    "zh": "只喝水。"
   },
   {
    "kr": "한 명만 왔어요.",
    "zh": "只来了一个人。"
   },
   {
    "kr": "이것만 주세요.",
    "zh": "只给我这个。"
   }
  ],
  "note": "「只有……（没有别的）」更常用 -밖에 없다，带否定谓语。",
  "cmp": "만 是中性限定；밖에 없다 带「不够/遗憾」的语气。"
 },
 {
  "id": "g035",
  "form": "-밖에 없다",
  "level": "初级",
  "cat": "限定",
  "attach": "名词 + 밖에 + 否定谓语",
  "meaning": "只有……",
  "desc": "必须和否定谓语搭配，表示「除此之外没有」。",
  "ex": [
   {
    "kr": "물밖에 없어요.",
    "zh": "只有水。"
   },
   {
    "kr": "오십 명밖에 안 왔어요.",
    "zh": "只来了五十个人。"
   },
   {
    "kr": "천 원밖에 없어요.",
    "zh": "只有一千韩元。"
   }
  ],
  "note": "后面一定要是否定：밖에 있어요 ✗。",
  "cmp": "-만 있다 是中性陈述「只有」；-밖에 없다 常隐含「比预期少」。"
 },
 {
  "id": "g036",
  "form": "-(이)나",
  "level": "初级",
  "cat": "选择",
  "attach": "名词 + (이)나",
  "meaning": "……或者…… / 就……（退而求其次）",
  "desc": "两个意思：一是列举选择；二是「退一步，就……吧」，带随便、将就的语气。",
  "ex": [
   {
    "kr": "커피나 차를 마실까요?",
    "zh": "喝咖啡还是茶？"
   },
   {
    "kr": "점심에 김밥이나 먹을까요?",
    "zh": "中午就吃个紫菜包饭之类的吧？"
   },
   {
    "kr": "주말에는 등산이나 하려고 해요.",
    "zh": "周末打算去爬个山什么的。"
   }
  ],
  "note": "有收音接 -이나，无收音接 -나。",
  "cmp": "「或者」也可以用 -거나，但那是接在动词后面的。"
 },
 {
  "id": "g037",
  "form": "-처럼",
  "level": "初级",
  "cat": "比较",
  "attach": "名词 + 처럼",
  "meaning": "像……一样",
  "desc": "比喻或举例，后面常接形容词或动词。",
  "ex": [
   {
    "kr": "저는 선생님처럼 되고 싶어요.",
    "zh": "我想成为像老师那样的人。"
   },
   {
    "kr": "얼음처럼 차가워요.",
    "zh": "像冰一样凉。"
   },
   {
    "kr": "친구처럼 한국어를 잘하고 싶어요.",
    "zh": "想像朋友那样韩语说得好。"
   }
  ],
  "note": "처럼 后面不能再接 은/는/이/가。",
  "cmp": "만큼 是「达到……的程度」，更像客观比较；처럼 是比喻。"
 },
 {
  "id": "g038",
  "form": "-마다",
  "level": "初级",
  "cat": "助词",
  "attach": "名词 + 마다",
  "meaning": "每……",
  "desc": "表示「每一个都」，可以接时间、地点、人。",
  "ex": [
   {
    "kr": "아침마다 커피를 마셔요.",
    "zh": "每天早上喝咖啡。"
   },
   {
    "kr": "주말마다 영화를 봐요.",
    "zh": "每个周末看电影。"
   },
   {
    "kr": "사람마다 생각이 달라요.",
    "zh": "每个人想法都不同。"
   }
  ],
  "note": "时间名词 + 마다 后不再加 에：아침마다（不是 아침에마다）。",
  "cmp": ""
 },
 {
  "id": "g039",
  "form": "-쯤",
  "level": "初级",
  "cat": "程度",
  "attach": "数量/时间 + 쯤",
  "meaning": "大约…… / 左右",
  "desc": "表示大概的数量或时间点。",
  "ex": [
   {
    "kr": "세 시쯤 만나요.",
    "zh": "三点左右见。"
   },
   {
    "kr": "열 명쯤 왔어요.",
    "zh": "来了十个人左右。"
   },
   {
    "kr": "내일쯤 도착할 거예요.",
    "zh": "大概明天到。"
   }
  ],
  "note": "也可以说 정도：세 시 정도，但 쯤 更口语。",
  "cmp": ""
 },
 {
  "id": "g040",
  "form": "-(으)ㄴ 지",
  "level": "初级",
  "cat": "时间",
  "attach": "动词过去式 + 지",
  "meaning": "已经……（多久了）",
  "desc": "表示从动作完成到现在经过了多长时间，后面常接 되다/지나다。",
  "ex": [
   {
    "kr": "한국에 온 지 일 년이 됐어요.",
    "zh": "来韩国已经一年了。"
   },
   {
    "kr": "운동을 시작한 지 두 달 됐어요.",
    "zh": "开始运动已经两个月了。"
   },
   {
    "kr": "이 책을 산 지 오래됐어요.",
    "zh": "这本书买了很久了。"
   }
  ],
  "note": "前面必须是过去式 -(으)ㄴ，后面接时间跨度 + 되다。",
  "cmp": "-기 전에 是「之前」，-(으)ㄴ 지 是「已经……了」，方向相反。"
 },
 {
  "id": "g041",
  "form": "-(으)ㄴ/는지",
  "level": "中级",
  "cat": "疑问",
  "attach": "词干 + 는지 / 은지",
  "meaning": "是否…… / ……什么……",
  "desc": "把疑问句变成名词性从句，常跟 알다/모르다/물어보다 搭配。",
  "ex": [
   {
    "kr": "내일 비가 오는지 알아요?",
    "zh": "你知道明天会不会下雨吗？"
   },
   {
    "kr": "그 사람이 누구인지 모르겠어요.",
    "zh": "我不知道那个人是谁。"
   },
   {
    "kr": "얼마인지 물어봤어요.",
    "zh": "问了多少钱。"
   }
  ],
  "note": "动词现在时接 -는지，形容词接 -(으)ㄴ지，过去时接 -았/었는지。",
  "cmp": "-는지 带疑问内容；-는 것 只是把动作名词化，没有疑问色彩。"
 },
 {
  "id": "g042",
  "form": "-더라",
  "level": "中级",
  "cat": "回想",
  "attach": "词干 + 더라",
  "meaning": "（我亲历发现）……啊",
  "desc": "说话人亲身经历后向别人转述新发现，只用于过去的事。",
  "ex": [
   {
    "kr": "그 영화 정말 재미있더라.",
    "zh": "那部电影真的挺好看。"
   },
   {
    "kr": "어제는 날씨가 춥더라.",
    "zh": "昨天挺冷的。"
   },
   {
    "kr": "그 식당 음식이 맛있더라.",
    "zh": "那家店的菜挺好吃。"
   }
  ],
  "note": "不能用于第一人称自己的感受：내가 예쁘더라 ✗。也不能用于说话当下。",
  "cmp": "-더라고요 是 -더라 的礼貌形，日常更常用。"
 },
 {
  "id": "g043",
  "form": "-던",
  "level": "中级",
  "cat": "回想",
  "attach": "词干 + 던 + 名词",
  "meaning": "（过去）曾经……的",
  "desc": "修饰名词，表示过去反复进行的动作或当时的状态。",
  "ex": [
   {
    "kr": "내가 자주 가던 카페가 문을 닫았어요.",
    "zh": "我常去的那家咖啡店关门了。"
   },
   {
    "kr": "어릴 때 살던 집이 생각나요.",
    "zh": "想起小时候住过的房子。"
   },
   {
    "kr": "그때 읽던 책을 아직 가지고 있어요.",
    "zh": "当时在读的书现在还留着。"
   }
  ],
  "note": "动作已完成用 -았/었던（갔던 곳 = 去过的地方）；-던 强调当时正在进行或反复。",
  "cmp": "-던 是回想；-(으)ㄴ 只是单纯的过去定语。"
 },
 {
  "id": "g044",
  "form": "-(으)ㄹ 텐데",
  "level": "中级",
  "cat": "推测",
  "attach": "词干 + ㄹ 텐데 / 을 텐데",
  "meaning": "应该会……（所以/但）",
  "desc": "先推测一个情况，再接着说由此带来的判断、建议或转折。",
  "ex": [
   {
    "kr": "지금쯤 도착했을 텐데 연락이 없네요.",
    "zh": "这会儿应该到了，可还没消息。"
   },
   {
    "kr": "많이 피곤할 텐데 조금 쉬세요.",
    "zh": "应该很累了，歇一会儿吧。"
   },
   {
    "kr": "내일은 바쁠 텐데 괜찮아요?",
    "zh": "明天应该很忙，你没关系吗？"
   }
  ],
  "note": "推测的是听话人或第三方的情况；说自己打算不能用 -(으)ㄹ 텐데。",
  "cmp": "-(으)ㄹ 거예요 只是推测；-(으)ㄹ 텐데 一定带后半句的转折或建议。"
 },
 {
  "id": "g045",
  "form": "-(으)ㄹ 뻔하다",
  "level": "中级",
  "cat": "推测",
  "attach": "词干 + ㄹ 뻔하다",
  "meaning": "差点……（但没发生）",
  "desc": "表示几乎发生某件不好的事，实际没有发生。",
  "ex": [
   {
    "kr": "버스를 놓칠 뻔했어요.",
    "zh": "差点错过公交。"
   },
   {
    "kr": "넘어질 뻔했어요.",
    "zh": "差点摔倒。"
   },
   {
    "kr": "시험에 떨어질 뻔했어요.",
    "zh": "差点考试不及格。"
   }
  ],
  "note": "只用于不希望发生的事；好事几乎发生要说 -(으)ㄹ 뻔했다 会显得奇怪。",
  "cmp": "-(으)ㄹ 뻔하다 是「差点」；-(으)ㄹ 정도다 是「到了……的程度」。"
 },
 {
  "id": "g046",
  "form": "-기 때문에",
  "level": "中级",
  "cat": "原因",
  "attach": "词干 + 기 때문에",
  "meaning": "因为……（所以）",
  "desc": "比 -아서/-(으)니까 更书面、更强调因果，常见于说明文和新闻。",
  "ex": [
   {
    "kr": "비가 오기 때문에 우산을 가져가세요.",
    "zh": "因为下雨，带上伞吧。"
   },
   {
    "kr": "너무 피곤하기 때문에 일찍 자려고 해요.",
    "zh": "因为太累，打算早睡。"
   },
   {
    "kr": "약속을 잘 지키기 때문에 믿을 수 있어요.",
    "zh": "因为他很守约，所以可以信任。"
   }
  ],
  "note": "名词后接 이기 때문에：학생이기 때문에。",
  "cmp": "口语里 -아서/어서、-(으)니까 更自然；-기 때문에 偏书面。"
 },
 {
  "id": "g047",
  "form": "-는 바람에",
  "level": "中级",
  "cat": "原因",
  "attach": "动词现在时 + 는 바람에",
  "meaning": "因为……（导致不好的结果）",
  "desc": "表示因为某个意外原因，造成了负面结果，后半句一定是消极的。",
  "ex": [
   {
    "kr": "늦잠을 자는 바람에 지각했어요.",
    "zh": "因为睡过头所以迟到了。"
   },
   {
    "kr": "비가 오는 바람에 경기가 취소됐어요.",
    "zh": "因为下雨比赛取消了。"
   },
   {
    "kr": "전화가 오는 바람에 잠을 깼어요.",
    "zh": "因为来了电话被吵醒了。"
   }
  ],
  "note": "前面只能是动词，且多用现在时；后面必须是不好的结果。",
  "cmp": "-는 통에 意思接近，但更强调混乱、嘈杂的场面。"
 },
 {
  "id": "g048",
  "form": "-느라고",
  "level": "中级",
  "cat": "原因",
  "attach": "动词 + 느라고",
  "meaning": "因为忙于……（所以没能……）",
  "desc": "表示因为专注于某个动作，导致后面的事没做到。前后主语必须一致。",
  "ex": [
   {
    "kr": "숙제를 하느라고 전화를 못 받았어요.",
    "zh": "因为忙着写作业没接到电话。"
   },
   {
    "kr": "요리를 하느라고 시간이 없었어요.",
    "zh": "因为忙做饭没时间。"
   },
   {
    "kr": "운동을 하느라고 아침을 못 먹었어요.",
    "zh": "因为忙着运动没吃早饭。"
   }
  ],
  "note": "后面一般是否定结果；前后主语必须相同。",
  "cmp": "-는 바람에 前后主语可以不同，-느라고 必须相同。"
 },
 {
  "id": "g049",
  "form": "-도록",
  "level": "中级",
  "cat": "目的",
  "attach": "词干 + 도록",
  "meaning": "使…… / 直到……",
  "desc": "表示目的、程度或让某个状态持续到某点。",
  "ex": [
   {
    "kr": "아이가 잠들도록 노래를 불렀어요.",
    "zh": "唱歌哄孩子睡着。"
   },
   {
    "kr": "내일까지 끝내도록 하세요.",
    "zh": "请到明天之前做完。"
   },
   {
    "kr": "늦지 않도록 서두르세요.",
    "zh": "别迟到，快一点。"
   }
  ],
  "note": "-도록 하다 是「让/做到」，-게 하다 是「使某人做」，后者更强调让某人动手。",
  "cmp": "-도록 还能表程度：목이 아프도록 웃었어요（笑得嗓子疼）。"
 },
 {
  "id": "g050",
  "form": "-게 하다",
  "level": "中级",
  "cat": "使役",
  "attach": "形容词/动词 + 게 하다",
  "meaning": "让……（做/变得）",
  "desc": "使役表达，让某人做某事或让某状态发生。",
  "ex": [
   {
    "kr": "아이를 웃게 했어요.",
    "zh": "把孩子逗笑了。"
   },
   {
    "kr": "선생님이 학생에게 책을 읽게 했어요.",
    "zh": "老师让学生读书。"
   },
   {
    "kr": "그 영화는 저를 울게 했어요.",
    "zh": "那部电影让我哭了。"
   }
  ],
  "note": "形容词接 -게 하다 是「使变得」：방을 깨끗하게 했어요。",
  "cmp": "-도록 하다 更偏「要求/安排」，-게 하다 是纯粹的使役。"
 },
 {
  "id": "g051",
  "form": "-아/어지다",
  "level": "中级",
  "cat": "变化",
  "attach": "形容词词干 + 아/어지다",
  "meaning": "变得……",
  "desc": "表示状态自然发生变化，不能用于动词。",
  "ex": [
   {
    "kr": "날씨가 따뜻해졌어요.",
    "zh": "天气变暖和了。"
   },
   {
    "kr": "한국어가 재미있어졌어요.",
    "zh": "韩语变得有趣了。"
   },
   {
    "kr": "그 사람은 유명해졌어요.",
    "zh": "那个人出名了。"
   }
  ],
  "note": "不能用于动词：가아지다 ✗；动词的变化要用 -게 되다。",
  "cmp": "-게 되다 是「（因外部原因）变成……」，-아/어지다 是状态自然变。"
 },
 {
  "id": "g052",
  "form": "-아/어 보다",
  "level": "中级",
  "cat": "尝试",
  "attach": "动词词干 + 아/어 보다",
  "meaning": "试着…… / 过……",
  "desc": "表示尝试做某事；过去式 -아/어 봤어요 表示「曾经做过」。",
  "ex": [
   {
    "kr": "이 음식을 먹어 봤어요?",
    "zh": "你吃过这个菜吗？"
   },
   {
    "kr": "제주도에 가 봤어요?",
    "zh": "你去过济州岛吗？"
   },
   {
    "kr": "한번 해 보세요.",
    "zh": "试一次吧。"
   }
  ],
  "note": "「经历过」必须用过去式 봤어요；보다 本身不表示「看」。",
  "cmp": "-아/어 본 적이 있다 更强调经历，-아/어 봤어요 更口语。"
 },
 {
  "id": "g053",
  "form": "-아/어 두다",
  "level": "中级",
  "cat": "状态",
  "attach": "动词词干 + 아/어 두다",
  "meaning": "预先做好……（并保持那个状态）",
  "desc": "表示提前完成某动作，让结果状态保留下来。",
  "ex": [
   {
    "kr": "음식을 미리 준비해 두었어요.",
    "zh": "提前把饭准备好了。"
   },
   {
    "kr": "창문을 닫아 두세요.",
    "zh": "把窗户关好（保持关着）。"
   },
   {
    "kr": "숙제를 다 해 두었어요.",
    "zh": "作业都做完了（留着）。"
   }
  ],
  "note": "和 -아/어 놓다 很接近，-아/어 두다 更强调「为了之后」。",
  "cmp": "-아/어 놓다 强调动作完成后的状态；-아/어 두다 强调提前准备。"
 },
 {
  "id": "g054",
  "form": "-고 나서",
  "level": "中级",
  "cat": "时间",
  "attach": "动词词干 + 고 나서",
  "meaning": "……之后",
  "desc": "强调前一动作完全结束后，再做后一动作。",
  "ex": [
   {
    "kr": "밥을 먹고 나서 약을 드세요.",
    "zh": "吃完饭再吃药。"
   },
   {
    "kr": "수업이 끝나고 나서 갈게요.",
    "zh": "下课后就去。"
   },
   {
    "kr": "숙제를 하고 나서 놀았어요.",
    "zh": "做完作业才玩的。"
   }
  ],
  "note": "前后主语必须一致；不能用在形容词后。",
  "cmp": "-고 只表先后，-고 나서 强调「彻底做完之后」。"
 },
 {
  "id": "g055",
  "form": "-자마자",
  "level": "中级",
  "cat": "时间",
  "attach": "动词词干 + 자마자",
  "meaning": "一……就……",
  "desc": "两个动作几乎同时发生，间隔极短。",
  "ex": [
   {
    "kr": "집에 도착하자마자 잠들었어요.",
    "zh": "一到家就睡着了。"
   },
   {
    "kr": "수업이 끝나자마자 집에 갔어요.",
    "zh": "一下课就回家了。"
   },
   {
    "kr": "전화를 받자마자 나갔어요.",
    "zh": "一接电话就出去了。"
   }
  ],
  "note": "前面不能用过去时：도착했자마자 ✗，要 도착하자마자。",
  "cmp": "-는 대로 也可以表「一……就」，但更书面、更像说明。"
 },
 {
  "id": "g056",
  "form": "-는 동안",
  "level": "中级",
  "cat": "时间",
  "attach": "动词现在时 + 는 동안",
  "meaning": "在……期间",
  "desc": "表示某个动作持续的整段时间。",
  "ex": [
   {
    "kr": "제가 여행하는 동안 고양이를 돌봐 주세요.",
    "zh": "我旅行期间请照看猫。"
   },
   {
    "kr": "기다리는 동안 커피를 마셨어요.",
    "zh": "等的期间喝了咖啡。"
   },
   {
    "kr": "방학 동안 아르바이트를 했어요.",
    "zh": "放假期间打了工。"
   }
  ],
  "note": "名词直接接 동안：방학 동안；动词要加 -는。",
  "cmp": "-는 사이에 强调「趁着这段时间（发生了别的）」。"
 },
 {
  "id": "g057",
  "form": "-기 전에",
  "level": "中级",
  "cat": "时间",
  "attach": "动词词干 + 기 전에",
  "meaning": "在……之前",
  "desc": "表示某动作发生之前的时间点。",
  "ex": [
   {
    "kr": "밥을 먹기 전에 손을 씻으세요.",
    "zh": "吃饭前先洗手。"
   },
   {
    "kr": "출발하기 전에 연락해 주세요.",
    "zh": "出发前请联系我。"
   },
   {
    "kr": "잠을 자기 전에 책을 읽어요.",
    "zh": "睡前读书。"
   }
  ],
  "note": "前面用动词原形（不加时态）：먹기 전에，不能说 먹었기 전에。",
  "cmp": "「之后」是 -(으)ㄴ 후에 / -고 나서。"
 },
 {
  "id": "g058",
  "form": "-(으)ㄴ 후에",
  "level": "中级",
  "cat": "时间",
  "attach": "动词过去式 + 후에",
  "meaning": "在……之后",
  "desc": "表示某动作完成之后。",
  "ex": [
   {
    "kr": "밥을 먹은 후에 커피를 마셨어요.",
    "zh": "吃完饭之后喝了咖啡。"
   },
   {
    "kr": "수업이 끝난 후에 만나요.",
    "zh": "下课后见。"
   },
   {
    "kr": "졸업한 후에 뭐 할 거예요?",
    "zh": "毕业后要做什么？"
   }
  ],
  "note": "前面用过去式 -(으)ㄴ；名词直接接 후에。",
  "cmp": "-고 나서 更口语，-(으)ㄴ 후에 稍书面，意思相同。"
 },
 {
  "id": "g059",
  "form": "-는 대신에",
  "level": "中级",
  "cat": "替代",
  "attach": "名词/动词 + 대신에",
  "meaning": "代替…… / 作为交换 / 反而",
  "desc": "三种用法：代替某人某物、以 A 换 B、以及「虽然……但（作为补偿）」。",
  "ex": [
   {
    "kr": "커피 대신에 차를 마셨어요.",
    "zh": "没喝咖啡，喝了茶。"
   },
   {
    "kr": "택시를 타는 대신에 버스를 탔어요.",
    "zh": "没打车，坐的公交。"
   },
   {
    "kr": "값이 비싼 대신에 품질이 좋아요.",
    "zh": "虽然贵，但质量好。"
   }
  ],
  "note": "名词直接接 대신에，动词接 -는 대신에，形容词接 -(으)ㄴ 대신에。",
  "cmp": ""
 },
 {
  "id": "g060",
  "form": "-(으)ㄹ수록",
  "level": "中级",
  "cat": "程度",
  "attach": "词干 + ㄹ수록 / 을수록",
  "meaning": "越……越……",
  "desc": "表示程度随另一条件递进，常和 -(으)면 搭配成「-면 -을수록」。",
  "ex": [
   {
    "kr": "배우면 배울수록 재미있어요.",
    "zh": "越学越有意思。"
   },
   {
    "kr": "생각할수록 화가 나요.",
    "zh": "越想越气。"
   },
   {
    "kr": "사람이 많을수록 좋아요.",
    "zh": "人越多越好。"
   }
  ],
  "note": "前面常配 -(으)면，也可以在句首用 아무리。",
  "cmp": ""
 },
 {
  "id": "g061",
  "form": "-는 편이다",
  "level": "中级",
  "cat": "判断",
  "attach": "动词现在时 / 形容词 + 는 편이다",
  "meaning": "算是…… / 偏向于……",
  "desc": "把一个绝对判断弱化成「大致上、偏向」的说法，语气更委婉。",
  "ex": [
   {
    "kr": "저는 아침형인 편이에요.",
    "zh": "我算是早起型。"
   },
   {
    "kr": "이 식당은 값이 싼 편이에요.",
    "zh": "这家店价格算便宜。"
   },
   {
    "kr": "그는 말수가 적은 편이에요.",
    "zh": "他话算是少的。"
   }
  ],
  "note": "动词接 -는 편이다，形容词接 -(으)ㄴ 편이다，名词接 인 편이다。",
  "cmp": ""
 },
 {
  "id": "g062",
  "form": "-기 마련이다",
  "level": "中级",
  "cat": "判断",
  "attach": "词干 + 기 마련이다",
  "meaning": "必然会…… / 总是会……",
  "desc": "表示某种结果带有必然性，常用来讲道理。",
  "ex": [
   {
    "kr": "열심히 하면 잘되기 마련이에요.",
    "zh": "努力就会有好结果。"
   },
   {
    "kr": "시간이 지나면 잊히기 마련이에요.",
    "zh": "时间久了总会淡忘。"
   },
   {
    "kr": "사람은 누구나 실수하기 마련이에요.",
    "zh": "谁都会犯错。"
   }
  ],
  "note": "语气偏书面、偏说理，日常对话里用 -는 법이다 或 -기 십상이다 更自然。",
  "cmp": "-는 법이다 意思接近，但更强调「规律」。"
 },
 {
